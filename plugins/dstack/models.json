{
  "schemaVersion": 3,
  "description": "DStack delegation policy read by the skills, not executable client configuration. The user-selected parent leads; each client uses its exact native worker route or work stays in the parent.",
  "orchestrator": {
    "model": "user-selected-parent",
    "reasoningEffort": "highest-supported",
    "owns": ["planning", "architecture", "difficult-implementation", "worker-review", "integration", "final-verification"]
  },
  "workers": {
    "codex": {
      "model": "gpt-5.6-luna",
      "reasoningEffort": "max",
      "fallback": "sequential-parent"
    },
    "claude": {
      "model": "haiku",
      "effort": "max",
      "fallback": "sequential-parent"
    }
  },
  "delegation": {
    "defaultMaxConcurrentWorkers": 2,
    "maxConcurrentWorkers": 3,
    "maxWorkerRevisions": 1,
    "allowNestedDelegation": false
  },
  "riskPolicy": {
    "local": 1,
    "crossModule": 2,
    "securityDataMonetization": 3,
    "critical": 4
  }
}
