{
  "schemaVersion": 2,
  "description": "DStack delegation policy read by the skills, not executable client configuration. The user-selected parent leads; every subagent uses the exact worker pair or work stays in the parent.",
  "orchestrator": {
    "model": "user-selected-parent",
    "reasoningEffort": "highest-supported",
    "owns": ["planning", "architecture", "difficult-implementation", "worker-review", "integration", "final-verification"]
  },
  "worker": {
    "model": "gpt-5.6-luna",
    "reasoningEffort": "max",
    "fallback": "sequential-parent"
  },
  "delegation": {
    "defaultMaxConcurrentWorkers": 2,
    "maxConcurrentWorkers": 3,
    "maxWorkerRevisions": 1,
    "allowNestedDelegation": false
  },
  "riskPolicy": {
    "local": 1,
    "crossModule": 2,
    "securityDataMonetization": 3,
    "critical": 4
  }
}
